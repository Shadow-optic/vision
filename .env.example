DATABASE_URL=postgres://postgres:postgres@localhost:5432/visioninjustice
DATABASE_MAX_CONNECTIONS=8
BIND_ADDR=0.0.0.0:8080

# ---- Live ingestion ----------------------------------------------------------
# Feeds to poll. Comma-separated names, or `all` for everything configured:
#   courtlistener-courts   court registry (no credentials) — needed to place a
#                          record in a forum, so keep it first
#   courtlistener-search   search API (no credentials), one feed per query below
#   courtlistener-feed     per-court Atom feeds (no credentials)
#   courtlistener          dockets + opinions API (requires CL_API_TOKEN); the
#                          only feed that yields complete opinion text
#   fixture                built-in record, no network
INGEST_SOURCES=courtlistener-courts,courtlistener-search,courtlistener-feed

# Search queries, semicolon-separated (queries contain commas).
# These decide where to look first. They decide nothing about what is concluded.
CL_SEARCH_QUERIES=brady violation;prosecutorial misconduct;fabricated evidence

# Court ids for the Atom feeds, comma-separated.
CL_FEED_COURTS=ca9,scotus

# Registry pages per cycle (100 courts per page; the full list is ~3,400).
CL_COURTS_PAGES=8

# CourtListener API token. Optional: without it the search and Atom feeds work,
# but opinion text is stored as a snippet and marked as such.
CL_API_TOKEN=

# Follow feed cursors backwards through history instead of re-reading the head.
INGEST_BACKFILL=0

# Empty = one cycle then exit; set e.g. 900 to poll every fifteen minutes.
INGEST_INTERVAL_SECS=

# Run the post-ingest engines after each cycle (0 disables). Everything the
# pipeline produces is pending counsel review.
INGEST_PIPELINE=1
INGEST_PIPELINE_LIMIT=200

RUST_LOG=info,vi_api=debug,vi_ingest=debug,vi_pipeline=debug
