DATABASE_URL=postgres://postgres:postgres@localhost:5432/visioninjustice
DATABASE_MAX_CONNECTIONS=8
BIND_ADDR=0.0.0.0:8080
CL_API_TOKEN=          # CourtListener API token (optional; fixture ingest works without it)
INGEST_SOURCE=fixture  # fixture | courtlistener
INGEST_INTERVAL_SECS=  # empty = one-shot poll; set e.g. 300 to loop
RUST_LOG=info,vi_api=debug,vi_ingest=debug
