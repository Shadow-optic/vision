{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vision",
	"main": "worker/index.ts",
	"compatibility_date": "2025-10-08",
	"observability": {
		"enabled": true
	},
	"vars": {
		// Origin of the Rust `vi-api` service. Empty means the Worker serves
		// the public-read API itself (live CourtListener search, empty Wall).
		// Set this to a `vi-api` origin when the counsel backend is published.
		"VI_API_ORIGIN": "",
		"SITE_NAME": "VisionInjustice",
		"CONTACT_EMAIL": "counsel@visioninjustice.org",
		"ENVIRONMENT": "production"
	},
	"ratelimits": [
		{
			"name": "PAGE_LIMITER",
			"namespace_id": "2001",
			"simple": {
				"limit": 600,
				"period": 60
			}
		},
		{
			"name": "API_LIMITER",
			"namespace_id": "2002",
			"simple": {
				"limit": 120,
				"period": 60
			}
		}
	],
	"workflows": [
		{
			"name": "my-workflow",
			"binding": "MY_WORKFLOW",
			"class_name": "MyWorkflow"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "WORKFLOW_STATUS",
				"class_name": "WorkflowStatusDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["WorkflowStatusDO"]
		}
	]
}
